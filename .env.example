# AI Alpha Hive — environment configuration
#
# Portability contract: hive keeps ZERO machine-specific state outside this
# file. Migrating to a new machine = install Go+Node, clone, copy your filled
# .env, done. Never commit a filled .env.
#
# Copy to .env and fill what you use. Every variable is optional until the
# feature that needs it is used; `hive doctor` reports what's missing.

# --- deploy: vercel driver (phase 1) ---
VERCEL_TOKEN=            # vercel.com/account/tokens
VERCEL_TEAM_ID=          # optional: deploy into a team scope

# --- deploy: droplet driver (any VPS, not just DigitalOcean) ---
DROPLET_HOST=            # e.g. 168.144.27.122 or a hostname
DROPLET_SSH_USER=        # default: root
DROPLET_APP_ROOT=        # default: /opt/hive-apps

# --- infra provisioning (optional, DigitalOcean) ---
DO_API_TOKEN=            # cloud.digitalocean.com/account/api/tokens

# --- deploy: static driver (phase 1) ---
STATIC_DEPLOY_TARGET=    # rsync/S3-compatible target URL

# --- modules (declared per-module in module.yaml; common ones below) ---
POSTMARK_SERVER_TOKEN=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
GA4_MEASUREMENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=       # payments module; also Issuing when card_provider=stripe-issuing (restricted key)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- company runtime (COMPANY-PLAN.md) ---
VAULT_KEY=               # 32 random bytes, base64; encrypts company secrets at rest
DATA_DIR=                # shared by platform/web and the runtime worker (default ./data)
DATABASE_URL=            # optional: libsql://... for the Vercel path; unset = SQLite file in DATA_DIR
DATABASE_AUTH_TOKEN=
ANTHROPIC_API_KEY=       # worker only; never in the web app env
STRIPE_WEBHOOK_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
POSTMARK_FROM=
GA4_SERVICE_ACCOUNT_JSON=

# --- providers (roles reference them as <provider>/<model>) ---
OPENROUTER_API_KEY=      # openrouter/<vendor>/<model> roles
# Ollama needs no key: ollama/<model> at http://localhost:11434/v1

# --- control plane API (runtime worker <-> web app / MCP) ---
HIVE_API_PORT=4700
HIVE_API_URL=http://localhost:4700   # web app + MCP server
HIVE_API_TOKEN=          # set on both sides when the worker is reachable beyond localhost
HIVE_PUBLIC_URL=http://localhost:4700   # OAuth callbacks land at <HIVE_PUBLIC_URL>/api/oauth/callback
HIVE_UI_URL=http://localhost:3000       # where OAuth returns the board after connecting

# --- integrations (values go in the company vault; env is the fallback) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOARD_CHAT_IDS=
SLACK_BOT_TOKEN=
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=
GA4_PROPERTY_ID=

# --- voice (optional server STT/TTS) ---
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
