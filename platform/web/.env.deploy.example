# Runtime configuration for this app — the ONE env file the droplet driver
# ships (docker --env-file). Copy to .env.deploy and fill. Never commit the
# filled file; .env.deploy is gitignored.

# rbac bootstrap preset (docs/specs/login-rbac.md §14)
AUTH_SECRET=        # >=32 random chars; session cookies are HMAC-signed with it
ADMIN_EMAIL=        # the bootstrap admin login
ADMIN_PASSWORD=     # replaced by argon2id user store in Stage B
