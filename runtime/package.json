{
  "name": "@alpha-hive/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Company runtime: providers (Anthropic, OpenRouter, Ollama, Claude Code), integrations library, side-effect gate, scheduler, ledger, control-plane API. Spawned by `hive company run`.",
  "type": "module",
  "bin": {
    "hive-company": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "check:manifest": "tsx scripts/check-manifest.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:templates": "tsx scripts/check-templates.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.2.0",
    "ulid": "^2.3.0",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
